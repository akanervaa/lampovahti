# Lämpövahdin omat Kconfig-asetukset.
#
# Oletusarvot ovat oikean raudan arvoja (datalehti, DESIGN.md). Simulaattorille ne ohitetaan
# prj.conf-tiedostossa, koska Wokwissa Zephyrin aika ja simuloitu anturi eivät kulje samaa tahtia
# (DESIGN.md, avoimet kysymykset).

mainmenu "Lampovahti"

# Zephyrin omat asetukset ladataan ensin.
source "Kconfig.zephyr"

menu "Lampovahti"

config LAMPO_SENSOR_PERIOD_MS
	int "Anturin lukujakso (ms)"
	default 1000
	range 100 60000
	help
	  Kuinka usein sensor-thread lukee lämpötilan (F1). Jakso pidetään
	  absoluuttisella ajalla, joten viive ei kerry.

config LAMPO_DRDY_TIMEOUT_MS
	int "Enimmäisodotus DRDY:lle ennen anturivikaa (ms)"
	default 2000
	range 100 60000
	help
	  Jos anturin DRDY-bitti ei nouse tässä ajassa, luku epäonnistuu ja
	  siitä ilmoitetaan anturivikana (F7). Datalehti: "give up after
	  about 2 s".

config LAMPO_HYST_BAND_CENTI
	int "Hystereesikaistan leveys (sadasosa-asteina)"
	default 30
	range 2 500
	help
	  Lämmitin syttyy, kun lämpötila on alle tavoite - kaista/2, ja sammuu,
	  kun se on yli tavoite + kaista/2. Kaistan sisällä tila pysyy (F2).
	  30 = tavoite ± 0.15 °C.

config LAMPO_ALARM_RANGE_CENTI
	int "Sallittu poikkeama tavoitteesta (sadasosa-asteina)"
	default 200
	range 10 5000
	help
	  Lämpötila on sallitulla alueella, kun se on enintään tämän verran
	  tavoitteesta (F3). 200 = ± 2 °C. Raja itse on vielä alueella.

config LAMPO_ALARM_DELAY_MS
	int "Hälytysviive (ms)"
	default 30000
	range 1000 3600000
	help
	  Kuinka kauan lämpötila saa olla yhtäjaksoisesti sallitun alueen
	  ulkopuolella ennen hälytystä (F3). Anturivika hälyttää heti.
	  Sama aika on kuittauksen torkku.

config LAMPO_SILENCE_MS
	int "Sensorin hiljaisuus ennen anturivikaa (ms)"
	default 2500
	range 500 120000
	help
	  Jos sensor-threadista ei kuulu mitään (ei lukemaa eikä vikailmoitusta)
	  tämän ajan, control tulkitsee anturin vikaantuneeksi (DESIGN.md 4.5).
	  Pitää olla suurempi kuin lukujakso + DRDY-aikakatkaisu.

config LAMPO_WDT_TIMEOUT_MS
	int "Vahtikoiran aikaraja (ms)"
	default 3000
	range 1500 8000
	help
	  Jos control-thread ei ruoki vahtikoiraa tämän ajan sisällä, piiri
	  käynnistyy uudelleen (F9). control herää vähintään sekunnin välein,
	  joten 3000 ms jättää kahden kierroksen marginaalin. RP2040:n
	  vahtikoiran enimmäisaika on noin 8.3 s.

endmenu
